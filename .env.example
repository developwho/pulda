OPENAI_API_KEY=
PULDA_MODEL=gpt-6-luna
PULDA_TRANSCRIBE_MODEL=gpt-live-transcribe
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
# Production: HTTPS origin, random 32+ character secret, DynamoDB table required.
SESSION_SECRET=
RATE_LIMIT_TABLE=
AWS_REGION=ap-southeast-2
# Global ceilings across all ECS tasks. Voice session: max 15 minutes.
MAX_DAILY_AI_CALLS=1000
MAX_DAILY_VOICE_SESSIONS=200
OPERATOR_NAME=
PRIVACY_EMAIL=
# Optional: direct Google Calendar registration; otherwise download .ics files.
VITE_GOOGLE_CLIENT_ID=
# Optional access code for the imported visit flow in production.
PULDA_ACCESS_CODE=
# Hospital concierge: local dev uses expiring process memory; production requires DynamoDB.
PULDA_CONCIERGE_MODEL=gpt-6-luna
CONCIERGE_TABLE=
# Required on Lambda; local Express can process queued searches in-process.
CONCIERGE_QUEUE_URL=
# Optional self-managed preferences, explicitly enabled by the user (no extraction model).
AGENTCORE_MEMORY_ID=
