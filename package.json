{
  "name": "pulda",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch --env-file=.env server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "build:concierge": "node scripts/build-concierge.mjs",
    "start": "node dist-server/index.js",
    "check:api": "node scripts/check-api.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1148.0",
    "@aws-sdk/client-dynamodb": "^3.1148.0",
    "@aws-sdk/client-sqs": "^3.1148.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@openai/agents": "^0.20.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "openai": "^7.31.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.6",
    "thinking-orbs": "^0.3.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
